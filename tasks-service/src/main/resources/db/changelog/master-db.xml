<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-description-to-issuetype" author="tokiniaina">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="issuetype" columnName="description"/>
            </not>
        </preConditions>
        <addColumn tableName="issuetype">
            <column name="description" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="fix-issue-label-table" author="tokiniaina">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="issue_label"/>
        </preConditions>
        <dropTable tableName="issue_label"/>
    </changeSet>

    <changeSet id="create-issue-label-table-clean" author="tokiniaina">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="issue_label"/>
            </not>
        </preConditions>

        <createTable tableName="issue_label">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="issue_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="label_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_issue_label_issue"
                baseTableName="issue_label"
                baseColumnNames="issue_id"
                referencedTableName="issue"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_issue_label_label"
                baseTableName="issue_label"
                baseColumnNames="label_id"
                referencedTableName="label"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="issue_label"
                columnNames="issue_id, label_id"
                constraintName="uk_issue_label"/>

    </changeSet>
    <changeSet id="rename-or-create-labels-table" author="tokiniaina">
        <!-- Cas 1 : la table 'label' existe → on renomme -->
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="label"/>
        </preConditions>
        <renameTable oldTableName="label" newTableName="labels"/>
    </changeSet>

    <changeSet id="create-labels-table" author="tokiniaina">
        <!-- Cas 2 : ni 'label' ni 'labels' n'existe → on crée -->
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="labels"/>
            </not>
        </preConditions>

        <createTable tableName="labels">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="style" type="VARCHAR(50)"/>
            <column name="color" type="VARCHAR(20)"/>
            <column name="icone_id" type="BIGINT"/>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_labels_project"
                baseTableName="labels"
                baseColumnNames="project_id"
                referencedTableName="Project"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_labels_icone"
                baseTableName="labels"
                baseColumnNames="icone_id"
                referencedTableName="Icone"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <createIndex indexName="idx_labels_project" tableName="labels">
            <column name="project_id"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>