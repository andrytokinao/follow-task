type CustomField {
    id:Int
    name:String
    type:String
    options:[String]
    project:Project
    configDisplay:[String]
    issueTypes:[UsingCustomField]
}
type Comment {
    id:Int
    text:String
    date:String
    issue:Issue
    user:UserApp
}
type File {
    name:String
    type:String
    files:[File]
}
type Credential{
    id:Int
    name:String
    roles:[RoleApp]
}

type CrossingState {
    id:Int
    name:String
    description:String
    from:Status
    to:Status
}
type GroupeUser {
    id:Int!
    prefix:String
    type:String
    name:String
    members:[MemberGroupe]
}
type MemberGroupe{
    id:Int!
    user:UserApp
    groupe:GroupeUser
    roles:[String]

}
type  Issue {
    id:Int
    summary:String
    description : String,
    creationDate:String
    issueType:IssueType
    assigne:UserApp
    status:Status
    reporter:UserApp
    directory:String
    issueKey:String
    passeTime:[EntryTime]
    parent:Issue,
    children:[Issue]
    comments:[Comment]
    files:[File]
    encodedPath:String
    values:[CustomFieldValue]
    project:Project
    labels:[IssueLabels]
    observerIds:[String]
    elapsedDurationMinutes:Int
    currentCompletionPercent:Int
    memberships:[IssueMembership]
    activeMemberships:[IssueMembership]
    assignes:[UserApp]

}

type IssueMembership {
    id:Int
    issue:Issue
    user:UserApp
    role:String
    assignedAt:String
    assignedBy:UserApp
    unassignedAt:String
    unassignedBy:UserApp
}
input IssueMembershipInput {
    id:Int
    issue:IssueInput
    user:UserAppInput
    role:String
    assignedAt:String
    assignedBy:UserAppInput
    unassignedAt:String
    unassignedBy:UserAppInput
}
type IssueLabels {
    id:Int
    issue:Issue
    label:Label
}
type IssueType{
    id:Int
    name:String
    description:String
    icone:Icone
    level:String
    prefix:String
    project:Project
    color:String
    style:String
    curentWorkFlow:WorkFlow
    usingCustomFields:[UsingCustomField]
    parent:IssueType
    children:[IssueType]
}

type Operation{
    id:Int
    date:String
    initial:String
    finale:String
    issue:Issue
    customField:CustomField
    userApp:UserApp
}

type EntryTime {
    id:Int,
    time:Float,
    date:String,
    userApp:UserApp
    issue:Issue
}
type Project{
    id:Int
    name:String
    prefix:String
    description:String
    statusConfig:String
    issueTypes:[IssueType]
    workFlows :[WorkFlow]
    events:[Event]
    issues:[Issue]
    domainActivity:DomainActivity
}



type Status{
    id:Int
    displayName:String
    color:String
    style:String
    icone:Icone
    types:[IssueType]
    fromeStates:[CrossingState]
    acctionPossible:[CrossingState]

}

type UserApp{
    id:String
    username:String
    firstName:String
    password:String
    pass:String
    lastName:String
    contact:String
    email:String
    address:String
    cin:String
    groupes:[MemberGroupe]
    operations:[Operation]
    repotrers:[Issue]
    entryTime:[EntryTime]
    photo:String
    code:Int
}

# Recherche paginee d'utilisateurs, pour l'administration des comptes.
input UserSearchInput {
    text:String      # nom, prenom, identifiant, e-mail, CIN ou contact
    page:Int         # a partir de zero
    size:Int
    sortBy:String    # name | username | cin
    sortAsc:Boolean
}
type UserPage {
    content:[UserApp]
    page:Int
    size:Int
    # Total avant pagination : sans lui, impossible d'afficher « 21-40 sur 137 »
    # ni de savoir combien de pages proposer.
    totalElements:Int
    totalPages:Int
}

type CustomFieldValue {
    id:Int,
