type CustomField {
    id:Int
    name:String
    type:String
    options:[String]
    configDisplay:[String]
    issueTypes:[UsingCustomField]
}
type Comment {
    id:Int
    text:String
    date:String
    issue:Issue
    user:UserApp
}
type File {
    name:String
    type:String
    files:[File]
}
type Credential{
    id:Int
    name:String
    roles:[RoleApp]
}

type CrossingState {
    id:Int
    name:String
    description:String
    from:Status
    to:Status
    credential:Credential
}
type GroupeUser {
    id:Int!
    prefix:String
    name:String
    members:[MemberGroupe]
}
type MemberGroupe{
    id:Int!
    user:UserApp
    groupe:GroupeUser
    roles:[String]

}
type  Issue {
    id:Int
    summary:String
    description : String,
    creationDate:String
    issueType:IssueType
    assigne:UserApp
    status:Status
    reporter:UserApp
    directory:String
    issueKey:String
    passeTime:[EntryTime]
    parent:Issue,
    children:[Issue]
    comments:[Comment]
    files:[File]
    encodedPath:String
    values:[CustomFieldValue]
    project:Project
}
type IssueType{
    id:Int
    name:String
    icone:Icone
    level:String
    prefix:String
    project:Project
    curentWorkFlow:WorkFlow
    usingCustomFields:[UsingCustomField]
    parent:IssueType
    children:[IssueType]
}

type Operation{
    id:Int
    date:String
    initial:String
    finale:String
    issue:Issue
    customField:CustomField
    userApp:UserApp
}

type EntryTime {
    id:Int,
    time:Float,
    date:String,
    userApp:UserApp
    issue:Issue
}
type Project{
    id:Int
    name:String
    prefix:String
    description:String
    statusConfig:String
    issueTypes:[IssueType]
    workFlows :[WorkFlow]
    events:[Event]
    issues:[Issue]
}



type Status{
    id:Int
    displayName:String
    icone:Icone
    types:[IssueType]
    fromeStates:[CrossingState]
    acctionPossible:[CrossingState]

}

type UserApp{
    id:String
    username:String
    firstName:String
    password:String
    pass:String
    lastName:String
    contact:String
    email:String
    address:String
    cin:String
    groupes:[MemberGroupe]
    operations:[Operation]
    repotrers:[Issue]
    entryTime:[EntryTime]
    photo:String
}

type CustomFieldValue {
    id:Int,
    customField:CustomField
    issue:Issue
    date:String
    string:String
    user:UserApp
    numeric:Float
    values:[String]
    text:String
}
type Repertoire{
    path:String
    fileName:String
    type:String
    icone:Icone
    repertoires:[Repertoire]
}
enum ValueType {
    DATE
    NUMBER
    STRING
    USER
}

type WorkFlow {
    id:Int,
    name:String,
    active :Boolean,
    statuses :[Status],
    issueTypes :[IssueType],
    project:Project
    crossingStates :[CrossingState],
}
type ConfigEntry{
    id:Int  ,
    version:String ,
    acive : Boolean,
    creation : String,
    workDirectory:String ,
    mediaDirectory :String ,
    dataDirectory :String,
    configDirectory :String,
    repertoireCodeValidation:String
}
type Icone{
    id:String
    typeIcone:String
    value:String
}
type UsingCustomField {
    id:Int
    customField:CustomField
    issueType:IssueType
}
type ConfigProject {
    id:Int
    configof:String
    value:String
}
input CustomFieldImput {
    id:Int
    name:String
    description:String
    type:String
    options:[String]
    configDisplay:[String]
    issueTypes:[CustomFieldImput]
}
input CredentialInput{
    id:Int
    name:String
    roles:[RoleAppInput]
}

input CrossingStateInput{
    id:Int
    name:String
    description:String
    from:Int
    to:Int
    credential:Int
}
input GroupeUserInput {
    id:Int!
    name:String
    mambers:[MemberGroupeInput]
}
input MemberGroupeInput{
    d:Int!
    user:UserAppInput
    groupe:GroupeUserInput
    roles:[RoleAppInput]
}

input  IssueInput {
    id:Int
    summary:String
    issueKey:String
    description : String
    directory:String
    parent:IssueInput,
    creationDate:String,
    issueType:IssueTypeInput
    assigne:UserAppInput
    status:StatusInput
    reporter:StatusInput
    project:ProjectInput
}
input IssueTypeInput{
    id:Int
    name:String
    prefix:String
    level:String
    parent:IssueTypeInput
    children:[IssueTypeInput]
    usingCustomFields:[UsingCustomFieldInput]
    icone:IconeInput
    project:ProjectInput
    statuses:[StatusInput]
    curentWorkFlow:WorkFlowInput
}

input OperationInput{
    id:Int
    date:String
    initial:String
    finale:String
    issue:Int
    costumField:Int
    userApp:Int
}

input PasseTimeInput {
    id:Int,
    time:Float,
    date:String,
    userApp:UserAppInput
    issue:Int
}
input ProjectInput{
    id:Int
    name:String
    description:String
    prefix:String
    events:[EventInput]
}

input RoleAppInput{
    id:Int
    name:String
    memberGroupes:[MemberGroupeInput]
    credentials:[Int]
}

input StatusInput{
    id:Int
    displayName:String
    icone:IconeInput
    types:[Int]
    fromeStates:[Int]
    acctionPossible:[Int]

}

input UserAppInput{
    id:String
    codeValidation:String
    confirm:String
    username:String
    firstName:String
    password:String
    pass:String
    lastName:String
    contact:String
    email:String
    address:String
    cin:String
    photo:String
    groupes:[MemberGroupeInput]
}

input ValueInput {
    id:Int,
    customField:CustomFieldImput
    issue:IssueInput
    date:String
    string:String
    user:UserAppInput
    numeric:Int,
    values:[String]
    text:String
}
input RepertoireInput {
    path:String
    fileName:String
    type:String
    icone:IconeInput
    repertoires:[RepertoireInput]
}

input WorkFlowInput {
    id:Int,
    name:String,
    project:ProjectInput
    active :Boolean,
    statuses :[StatusInput],
    issueTypes :[IssueTypeInput],
    crossingStates :[CrossingStateInput],
}
input CommentInput {
    id:Int
    text:String
    date:String
    issue:IssueInput
    user:UserAppInput
}
input ConfigEntryInput{
    id:Int
    version:String
    acive : Boolean
    creation : String
    workDirectory:String
    mediaDirectory :String
    dataDirectory :String
    configDirectory :String
    repertoireCodeValidation:String
}
input IconeInput{
    id:String
    typeIcone:String
    value:String
}
input CriteriaInput {
    field:String
    value:String
    operator:String
    sousCriteria:[CriteriaInput]
}
input UsingCustomFieldInput {
    id:Int
    customField:CustomFieldImput
    issueType:IssueTypeInput
}
input ConfigProjectInput {
    id:Int
    configof:String
    value:String
}
input IssueSearchCriteriaInput {
    key: String
    summary: String
    dateFrom: String
    dateTo: String
    statusIds: [ID]
    issueTypeIds: [ID]
    issueTypeLevels:[String]
    assigneUsernames: [String]
    customFieldStringValues: [CustomFieldStringValuesInput]
    customFieldDateValues: [CustomFieldDateValuesInput]
    customFieldDateValueFrom: [CustomFieldDateValueFromInput]
    customFieldDateValueTo: [CustomFieldDateValueToInput]
    customFieldUserIds: [CustomFieldUserIdsInput]
    customFieldIssueIds: [CustomFieldIssueIdsInput]
    customFieldTextValues: [CustomFieldTextValuesInput]
    projectId:Int
}

input CustomFieldStringValuesInput {
    customFieldId: ID
    values: [String]
}

input CustomFieldDateValuesInput {
    customFieldId: ID
    values: [String]
}

input CustomFieldDateValueFromInput {
    customFieldId: ID
    value: String
}

input CustomFieldDateValueToInput {
    customFieldId: ID
    value: String
}

input CustomFieldUserIdsInput {
    customFieldId: ID
    userIds: [String]
}

input CustomFieldIssueIdsInput {
    customFieldId: ID
    issueIds: [ID]
}

input CustomFieldTextValuesInput {
    customFieldId: ID
    textValues: [String]
}
type Event {
    id: ID!
    title: String!
    description: String
    eventType: EventType!
    start: String!
    end: String
    location: String
    allDay: Boolean!
    reminderTime: String
    customColor: String
    customStyle: String
    reminderOffset: Int
    user: UserApp!
    issue: Issue
}
input EventInput {
    id: ID
    title: String!
    description: String
    eventType: EventTypeInput!
    start: String!
    end: String
    location: String
    allDay: Boolean!
    reminderTime: String
    customColor: String
    customStyle: String
    reminderOffset: Int
    user: UserAppInput
    issue: IssueInput
}
type EventType {
    id: ID!
    name: String!
    description: String
    defaultColor: String
    defaultStyle: String
    events: [Event]
}
input EventTypeInput {
    id:ID
    name: String!
    description: String
    defaultColor: String
    defaultStyle: String
}
input EventSearchCriteriaInput {
    userIds: [String]  # Liste d'IDs des utilisateurs, facultatif
    issueIds: [ID]  # Liste d'IDs des issues, facultatif
    parrentIds:[Int] # Liste d'IDs des parent d'issues
    projectId:Int
    start: String  # Date/heure de début, facultatif
    end: String  # Date/heure de fin, facultatif
}

type Permission {
    name:String
    roles:[RoleApp]
}
type RoleApp{
    name:String
    description:String
    accessibilities:[String]
}
input DocumentInput{
    id:Int
    titre:String
    description:String
    typeDocument:String
    uploadeds:[UploadedInput]
    creation:String
    userApp:UserAppInput
    issues:IssueInput
}
input UploadedInput{
    id:Int
    name:String
    encodedPath:String
    path:String
    document:DocumentInput
}
type Document{
    id:Int
    titre:String
    description:String
    typeDocument:String
    uploadeds:[Uploaded]
    creation:String
    userApp:UserApp
    issues:Issue

}
type Uploaded{
    id:Int
    name:String
    encodedPath:String
    path:String
    document:Document
}
