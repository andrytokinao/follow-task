extend enum TypeCanal {
  WHATSAPP
  FACEBOOK
  TELEGRAM
  INSTAGRAM
  SLACK
  SMS
  EMAIL
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  SYSTEM
  UNKNOWN
}

type Member {
  externalUserId: String!
  displayName: String
  phoneOrContact: String
  admin: Boolean
  contactId: ID
  userAppId: ID
}

type Attachment {
  externalMessageId: String
  externalAttachmentId: String
  fileName: String
  mimeType: String
  sizeBytes: Int
  caption: String
  mediaType: MediaType
  senderExternalId: String
  fromMe: Boolean
  downloaded: Boolean
  downloadUrl: String
  createdAt: String
}

type MessageDto {
  externalMessageId: String!
  canalExternalId: String!
  text: String
  mediaType: MediaType
  senderExternalId: String
  senderDisplayName: String
  senderAvatarUrl: String
  createdAt: String!
  fromMe: Boolean!
  hasAttachment: Boolean!
  attachments: [Attachment]
  messageLinks: [IssueMessageLink]
}

type MessageApp {
  id: ID!
  externalMessageId: String
  canalExternalId:String
  canall: Canal!
  created: String!
  text: String!
  mediaType: String
  sender: UserApp
  fallbackSenderName: String
  processed: Boolean!
  messageLinks: [IssueMessageLink!]
  userReades: [ID!]
}

input MessageAppInput {
  id: ID
  canall: CanallInput
  created: String
  text: String
  sender: UserAppInput
  userReades: [ID]
}

type Canal {
  externalId: String
  pseudo: String
  typeCanal: TypeCanal
  isGroup: Boolean
  unreadCount: Int
  messageCount: Int
  description: String
  ownerExternalId: String
  memberCount: Int
  avatarUrl: String
  members: [Member]
  lastMessage: MessageDto
  issueLinks:[IssueCanalLink]
}

input SendMessageInput {
  text: String!
  mediaUrl: String
  mediaType: MediaType
}

input MessageQueryInput {
  page: Int = 0
  size: Int = 20
  since: String
  until: String
}
type CanalWatcherInfo {
  canalId: ID!
  userAppId: String!
  grantedByUserAppId: String
  grantedAt: String!
  reason: String
}
extend type Query {
  listCanaux(type: TypeCanal!): [Canal!]!
  getCanal(type: TypeCanal!, externalId: String!): Canal
  listMessages(type: TypeCanal!, canalExternalId: String!, query: MessageQueryInput): [MessageDto!]!
  listMessagesEntity(type: TypeCanal!, canalExternalId: String!, query: MessageQueryInput): [MessageApp!]!
  listAttachments(type: TypeCanal!, canalExternalId: String!): [Attachment!]!
  getMessage(type: TypeCanal!, externalMessageId: String!): MessageDto
  listVisibleCanauxForUser(userId: String!): [Canall!]!
}

extend type Mutation {
  sendExternalMessage(type: TypeCanal!, canalExternalId: String!, input: SendMessageInput!): MessageDto!
  syncCanal(type: TypeCanal!): Boolean!
  grantCanalAccess(canalId: ID!, userId: String!, reason: String): CanalWatcherInfo!
  revokeCanalAccess(canalId: ID!, userId: String!): Boolean!

  linkIssueToMessage(issueId: Int!, externalMessageId: String!): IssueMessageLink!
  unlinkIssueFromMessage(linkId: ID!): Boolean!
  linkIssueToCanal(issueId: Int!, canalExternalId: String!): IssueCanalLink!
  unlinkIssueFromCanal(linkId: ID!): Boolean!
}

type IssueMessageLink {
  id: ID
  issue: Issue
  message: MessageDto
  linkedAt: String
  linkedBy: UserApp
}

type IssueCanalLink {
  id: ID
  issue: Issue
  canall: Canall
  linkedAt: String
  linkedBy: UserApp
}
extend type Issue {
  canalLinks: [IssueCanalLink]
  messageLinks: [IssueMessageLink]
}