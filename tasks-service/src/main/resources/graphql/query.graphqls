type Query {
    getUser(username: String!): UserApp,
    allUsers : [UserApp],
    # Recherche paginee : la page d'administration chargeait tous les comptes
    # pour n'en afficher qu'une vingtaine.
    searchUsers(criteria:UserSearchInput):UserPage
    allIssue :[Issue]
    findIssueById(id:Int) :[Issue]
    findIssueByUserId(id:String):[Issue]
    findAllStatus:[Status]
    allComment(issueId:Int):[Comment]
    allFiles(issueId:Int):[File]
    allCustomFieldByIssue(issueId:Int):[CustomField]
    getCustomField(id:Int):CustomField
    getValues(issueId:Int):[CustomFieldValue]
    getIssueTypeById(issueTypeId:Int):IssueType
    loadDirectory(issueId:Int):Repertoire
    loadGroupeMember(userId:String):[MemberGroupe]
    allGroupes:[GroupeUser]
    getConfig(typeEntry:String):[ConfigEntry]
    allConfig:[ConfigEntry]
    allProjects:[Project]

    getWorkFlow(workFlowId:Int):WorkFlow
    allWorkFlow:[WorkFlow]
    workFlowsByProject(projectId:Int):[WorkFlow]

    getProject(prefix:String):Project
    getConfigProject(projectId:Int):[ConfigProject]
    getIssueType(issueTypeId:Int):IssueType
    allIssueType(projectId:Int):[IssueType]
    issueByCriteria(criterias:[CriteriaInput]):[Issue]
    allCustomField(projectId:Int):[CustomField]
    customFieldsByIssueType(issueTypeId:Int):[UsingCustomField]
    getGroupeUserForProject(prefix:String):[GroupeUser]
    listIssueTypeMaster(projectId:Int):[IssueType]
    listIssueTypeSubtasks(masterId:Int):[IssueType]
    getNextKey(issueTypeId:Int):String
    getNextKeyParent(issueTypeId:Int,projectId:Int):String
    getIssue(issueKey:String):Issue
    loadSubtask(parentId:Int):[Issue]
    loadIssueMasterByProject(projectId:Int):[Issue]
    searchIssues(criteria:IssueSearchCriteriaInput):[Issue]
    allEventType:[EventType]
    searchEvents(criteria:EventSearchCriteriaInput):[Event]
    # Dates du projet portées par les champs personnalisés, sans passer par un
    # événement de planning. Réutilise EventSearchCriteriaInput : les critères
    # utiles sont exactement les mêmes (projet, période, champs, niveau).
    projectDateValues(criteria:EventSearchCriteriaInput):[CustomFieldValue]
    nextEvent(criteria:EventSearchCriteriaInput,projectId:Int):Event
    getByEventId(eventId:Int):Event
    getProjectByUser(userId:String):[Project]
    loadPermissiontTask:Permission
    getDocuments(issueId:Int,typeDocument:String):[Document]
    loadDocumentById(documentId:Int):Document
    listActivity:[DomainActivity]
    getMyFilters(projectId:Int,userId:String):[IssueFilter]
    getLabelByProject(projectId:Int):[Label]
    getIssueById(issueId:Int):Issue
    getSettings(userId:String):[AppSettings]
    getCanalByProject(projectId:Int,userIds:[String]):[Canall]
    getNotificationsByUserId(userId:String):[Notification]

    getDocument(id: Int!): Document
    searchDocuments(search: DocumentSearchInput, page: Int, size: Int): DocumentPage
    getMyDocuments(userId: String!, search: DocumentSearchInput, page: Int, size: Int): DocumentPage
    getDocumentThread(parentId: Int!): [Document]
    getUnreadResponsesCount(documentId: Int!, userId: String!): Int
    getDocumentMembers(documentId: Int!): [DocumentMember]
    getUploadedsByDocument(documentId: Int!): [Uploaded]
    documentUsageTypes:[DocumentUsageTypeMeta]
    getIssuePlanningSummary(issueId: ID!): IssuePlanningSummary
    getIssuePlanningSummaries(issueIds: [ID!]!): [IssuePlanningSummary!]!
    proposeNextPercentage(issueId:ID!):PercentageProposal
    getAtachedDocumentIssue(documentId:ID):[IssueDocumentUsage]
    loadUserHours(issueId:ID!):[UserHoursData]
    issueMemberships(issueId:Int):[IssueMembership]
}
