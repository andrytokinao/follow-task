# Cockpit de direction.
#
# Vocabulaire du modèle : un « projet » est une demande racine (Issue sans
# parent, avec des tâches) ; un « département » est l'espace de travail
# (Project) qui la porte.

extend type Query {
    # Noms des espaces de travail : les onglets du cockpit.
    directionDepartements: [String]
    # Projets en cours (non terminés) ; tous les départements si null.
    directionProjets(departement: String): [Issue]
}

extend type Mutation {
    # Donne (true) ou retire (false) le rôle système DIRECTION. Administrateur
    # du système seulement.
    definirDirection(userId: String!, direction: Boolean!): MemberGroupe
}

extend type Issue {
    # Début du premier événement de planning déjà commencé ; null si jamais traitée.
    dateDebutTraitement: String
    # Nombre de commentaires (documents COMMENT_FILES non supprimés).
    nombreCommentaires: Int
    # Nombre de fichiers du répertoire de la demande, sous-dossiers compris.
    nombrePiecesJointes: Int
    # Chiffres du rapport de projet (RapportService.genererRapport).
    rapportProjet: RapportProjet
}

type RapportProjet {
    departement: String
    prefixeDepartement: String
    avancementGlobal: Int
    synthese: SyntheseProjet
}

type SyntheseProjet {
    # Heures passées sur l'ensemble des tâches du projet.
    totalHeures: Float
    nombreTaches: Int
    nombreTerminees: Int
    nombreEnRetard: Int
}
