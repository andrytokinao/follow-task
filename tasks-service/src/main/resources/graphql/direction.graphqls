# Cockpit de direction.
#
# Vocabulaire du modèle : un « projet » est une demande racine (Issue sans
# parent, avec des tâches) ; un « département » est l'espace de travail
# (Project) qui la porte.

extend type Query {
    # Noms des espaces de travail : les onglets du cockpit.
    directionDepartements: [String]
    # Espaces de travail avec leur préfixe : le cockpit en choisit toujours
    # un, désigné dans l'adresse (/direction/TOPO).
    directionEspaces: [EspaceDirection]
    # Projets en cours (non terminés) ; tous les départements si null.
    directionProjets(departement: String): [Issue]
}

extend type Mutation {
    # Donne (true) ou retire (false) le rôle système DIRECTION. Administrateur
    # du système seulement.
    definirDirection(userId: String!, direction: Boolean!): MemberGroupe
}

extend type Issue {
    # Début du premier événement de planning déjà commencé ; null si jamais traitée.
    dateDebutTraitement: String
    # Début du plus ancien événement de planning, passé ou à venir ; null sans
    # événement. Ordre des tâches du Gantt de direction.
    debutExecution: String
    # Nombre de commentaires (documents COMMENT_FILES non supprimés).
    nombreCommentaires: Int
    # Nombre de fichiers du répertoire de la demande, sous-dossiers compris.
    nombrePiecesJointes: Int
    # Chiffres du rapport de projet (RapportService.genererRapport).
    rapportProjet: RapportProjet
    # Valeur du champ « Date Démarrage » fourni par l'application ; null si non saisie.
    dateDemarrage: String
    # Valeur du champ « Deadline » fourni par l'application ; null si non saisie.
    deadline: String
    # Séances de planning de la tâche, de la plus ancienne à la plus récente :
    # les barres du diagramme de Gantt.
    realisations: [RealisationTache]
    # Liens de dépendance actifs partant de la tâche (bloque, précède,
    # déclenche) : les flèches du diagramme de Gantt.
    dependances: [DependanceTache]
}

type EspaceDirection {
    # Nom affiché, et valeur des filtres « departement ».
    nom: String
    prefixe: String
}

# Dépendance d'une tâche vers une autre (lien IssueLink de type dépendance).
type DependanceTache {
    id: Int
    # BLOCKS, PRECEDES, TRIGGERS.
    type: String
    # Libellé lu depuis la source : « bloque », « précède », « déclenche ».
    libelle: String
    # Tâche qui dépend de celle-ci ; elle peut être d'un autre projet.
    destinationId: Int
}

# Une séance de travail sur une tâche (événement de planning).
type RealisationTache {
    id: Int
    titre: String
    debut: String
    # null si la fin n'a pas été renseignée.
    fin: String
    # Avancement de la tâche déclaré à l'issue de la séance.
    avancement: Int
    # PENDING, IN_PROGRESS, COMPLETED, BLOCKED, POSTPONED, EXTENDED.
    etat: String
    intervenant: UserApp
}

extend type Event {
    # État d'exécution de la séance : PENDING, IN_PROGRESS, COMPLETED, BLOCKED,
    # POSTPONED, EXTENDED. Le Gantt de direction en tire le réalisé du planifié.
    executionStatus: String
}

type RapportProjet {
    departement: String
    prefixeDepartement: String
    avancementGlobal: Int
    synthese: SyntheseProjet
}

type SyntheseProjet {
    # Heures passées sur l'ensemble des tâches du projet.
    totalHeures: Float
    nombreTaches: Int
    nombreTerminees: Int
    nombreEnRetard: Int
}
